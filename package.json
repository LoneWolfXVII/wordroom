{
  "name": "wordroom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @wordroom/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "seed:wordbank": "node supabase/scripts/seed-word-bank.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.58.1",
    "husky": "9.1.7",
    "typescript": "5.9.3"
  }
}
